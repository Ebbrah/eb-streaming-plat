{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "NODE_ENV=production npx webpack --config webpack.config.js",
    "test": "jest --watchAll",
    "setup-publishing": "./setup-publishing.sh",
    "setup-google-play": "./setup-google-play.sh",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "build:ios:local": "eas build --platform ios --profile production --local",
    "build:android:local": "eas build --platform android --profile production --local",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "build:preview": "eas build --profile preview",
    "build:development": "eas build --profile development"
  },
  "dependencies": {
    "@expo/metro-config": "^0.20.14",
    "@expo/vector-icons": "^14.0.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "axios": "^1.6.2",
    "expo": "53.0.11",
    "expo-av": "15.1.6",
    "expo-font": "13.3.1",
    "expo-status-bar": "2.2.3",
    "metro": "^0.82.4",
    "metro-core": "^0.82.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.79.3",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "style-loader": "^4.0.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "private": true
}
