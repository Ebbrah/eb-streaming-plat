{
  "name": "netflix-clone",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "yarn workspace @mana/web start",
    "mobile": "yarn workspace mana-movies start",
    "android-tv": "yarn workspace @mana/android-tv start",
    "server": "yarn workspace @mana/server start",
    "dev": "concurrently \"yarn server\" \"yarn web\"",
    "start": "next start",
    "build": "npx expo export"
  },
  "devDependencies": {
    "@types/react-dom": "^19",
    "@types/react-native-web": "^0",
    "concurrently": "^8.2.0"
  },
  "packageManager": "yarn@4.9.2",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.842.0",
    "@expo/metro-runtime": "~5.0.4",
    "react-dom": "19.0.0",
    "react-native-web": "^0.20.0"
  }
}
